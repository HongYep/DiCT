  "gradient_accumulation_steps": 4,
  "warmup_ratio": 0.03,
  "save_strategy": "steps",
  "save_steps": 100,
  "save_total_limit": 2,
  "max_length": 4096,
  "lazy_tokenize": true,
  "loss_scale": "default",
  "packing": false,
  "model_type": "qwen3_vl",
